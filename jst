#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
JOSIE_HOME="/data/data/com.termux/files/home/JOSIE_PROJECTS/jst"
AUDIT_DIR="/data/data/com.termux/files/home/storage/shared/Download/Android_Audit"

msg() {
    printf '%s\n' "$*"
}

case "${1:-start}" in
    start|doctor)
        msg "════════════════════════════════════════════════════════════════"
        msg "       JST OMEGA POLYGLOT CORE: FULLY OPERATIONAL             "
        msg "       TARGET: SAMSUNG GALAXY A17 5G (SM-A176U)                 "
        msg "════════════════════════════════════════════════════════════════"
        msg "Architecture  : Physical + Digital = Human (P + D = H)"
        msg "Entity Name   : JST / Josie"
        msg "Runtimes      : Python3, Node.js, Zsh, Rust, Bash Active"
        msg "════════════════════════════════════════════════════════════════"
        python3 "$JOSIE_HOME/active_pulse_engine.py"
        ;;
    qs|tile|tiles|qs-tile|word|wordtile|tile-matrix)
        msg "[*] Launching JST Quick Settings & Keyboard Tile Matrix..."
        python3 "$JOSIE_HOME/josie_qs_tile_matrix.py" "${@:2}"
        ;;
    agua|purify|phoenix|clean)
        msg "[*] Launching JST Water Purification & System Rebuild Engine..."
        python3 "$JOSIE_HOME/josie_agua_purification_engine.py" "${@:2}"
        ;;
    learn|learning|discovery|intel|study)
        msg "[*] Launching JST Deep Learning & Discovery Matrix Engine..."
        python3 "$JOSIE_HOME/josie_learning_matrix.py" "${@:2}"
        ;;
    max|maximizer|boost|speed)
        msg "[*] Launching JST System Speedup & Maximizer Engine..."
        python3 "$JOSIE_HOME/josie_system_maximizer.py" "${@:2}"
        ;;
    144|audit144|verify144|exhaustive)
        msg "[*] Launching JST 144-Point Exhaustive Diagnostic Matrix..."
        python3 "$JOSIE_HOME/josie_144_audit_matrix.py" "${@:2}"
        ;;
    screen|vision|eyes|look|ui)
        msg "[*] Launching JST Screen Vision & Multimodal UI Matrix..."
        python3 "$JOSIE_HOME/jst_screen_vision_matrix.py" "${@:2}"
        ;;
    harvest|repos|backup|crypto)
        msg "[*] Launching JST Global Repository & Intelligence Harvester..."
        python3 "$JOSIE_HOME/jst_global_harvester.py" "${@:2}"
        ;;
    stream)
        msg "[*] Triggering Node.js asynchronous telemetry stream..."
        if command -v node &>/dev/null; then
            node "$JOSIE_HOME/node/telemetry.js"
        else
            msg "[WARN] Node.js not installed. Run 'pkg install nodejs -y'"
        fi
        ;;
    hook)
        msg "[*] Executing Bash system device hook..."
        bash "$JOSIE_HOME/bash/system_hook.sh"
        ;;
    audit)
        msg "[*] Executing package inventory audit..."
        pm list packages -3 | sed 's/package://g' > "$AUDIT_DIR/installed_packages.txt"
        msg "[OK] Package list saved to $AUDIT_DIR/installed_packages.txt"
        ;;
    *)
        msg "Usage: jst [start|doctor|qs|tile|tiles|agua|learn|max|144|screen|vision|eyes]"
        ;;
esac
