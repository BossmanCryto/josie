def cmd_memory(query):
    print_banner()
    if not os.path.exists(DB_PATH):
        print("⚠️ Memory database not found at", DB_PATH)
        return
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    if query:
        print(f"🧠 \033[1;33mQuerying Permanent Memory Vault for '{query}'...\033[0m\n")
        c.execute("SELECT timestamp, event, outcome FROM memory WHERE event LIKE ? OR outcome LIKE ? ORDER BY id DESC LIMIT 5", (f"%{query}%", f"%{query}%"))
    else:
        print("🧠 \033[1;33mRecent Knowledge & Event Memories:\033[0m\n")
        c.execute("SELECT timestamp, event, outcome FROM memory ORDER BY id DESC LIMIT 5")
    rows = c.fetchall()
    conn.close()

    if not rows:
        print("No matching memories found.")
        return
    for r in rows:
        print(f"\033[1;36m• [{r[0]}]\033[0m \033[1m{r[1]}\033[0m")
        print(f"  \033[0;37m↳ {r[2][:250]}\033[0m\n")

def cmd_ask(prompt):
    print("⚡ \033[1;33mJosie AGI Core:\033[0m Processing prompt...\n")
    try:
        data = json.dumps({"prompt": prompt, "model": "anthropic/claude-3.7-sonnet"}).encode()
        req = urllib.request.Request("http://127.0.0.1:8080/chat", data=data, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=20) as r:
            res = json.loads(r.read().decode())
            print(res.get("reply", "(No response)"))
    except Exception as e:
        # Direct CLI fallback via Pollinations
        try:
            clean = urllib.parse.quote(prompt[:400])
            req = urllib.request.Request(f"https://text.pollinations.ai/{clean}", headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=12) as r:
                print(r.read().decode().strip())
        except Exception as e2:
            print(f"⚠️ Error: {e} / {e2}")

