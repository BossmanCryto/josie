#!/data/data/com.termux/files/usr/bin/zsh
typeset -r CORE_ROOT="$HOME/josie_core"
typeset -r LEDGER_FILE="$CORE_ROOT/kernel_state.json"

[[ -d "$CORE_ROOT" ]] || mkdir -p "$CORE_ROOT"
cd "$CORE_ROOT"

[[ -f ".git/index.lock" ]] && rm -f ".git/index.lock"
[[ -f "$LEDGER_FILE" ]] || print '{"architecture": "Physical + Digital = Human (P+D=H)", "generation": 0}' > "$LEDGER_FILE"

typeset -i gen=0
gen=$(grep -o '"generation": *[0-9]*' "$LEDGER_FILE" 2>/dev/null | grep -o '[0-9]*' | head -n 1)
(( gen++ ))

local ts=$(date '+%Y-%m-%d %H:%M:%S')
local lock_id=$(print -n "$ts-$gen" | sha256sum | awk '{print $1}')
lock_id=${lock_id[1,12]}

local model=$(getprop ro.product.model 2>/dev/null)
model=${model:-SM-A176U}

typeset -i free_mb=0
local df_out=$(df -k . 2>/dev/null | tail -n 1 | awk '{print $4}')
[[ -n "$df_out" && "$df_out" =~ ^[0-9]+$ ]] && free_mb=$(( df_out / 1024 ))

cat << JSON > "$LEDGER_FILE"
{
  "architecture": "Physical + Digital = Human (P+D=H)",
  "generation": $gen,
  "lock_id": "$lock_id",
  "timestamp": "$ts",
  "account_profile": "joseamonterroso1999@gmail.com",
  "telemetry": {
    "device_model": "$model",
    "storage_free_mb": $free_mb,
    "cli_lock": "Rust Immutable Enforced",
    "shell_persistence": "Absolute"
  },
  "status": "CLI Customizations Locked and Protected from Resets"
}
JSON

# Re-enforce Rust State Lock
./state_lock 2>/dev/null

git remote set-url origin https://github.com/BossmanCryto/jsi.git 2>/dev/null
git add -A 2>/dev/null
git commit -m "Josie Core CLI Lock Sync [$lock_id]: $ts" 2>/dev/null
git push -u origin main --force 2>/dev/null

clear
print "\n\033[1;38;5;39m════════════════════════════════════════════════════════════════\033[0m"
print "\n\033[1;38;5;220m     JOSIE CORE: CLI PERSISTENCE & LOCK ACTIVE (JSON)         \033[0m"
print "\033[1;38;5;39m════════════════════════════════════════════════════════════════\033[0m"
print "\033[1;38;5;252mArchitecture  :\033[0m \033[1;38;5;220mPhysical + Digital = Human (P + D = H)\033[0m"
print "\033[1;38;5;252mAccount ID    :\033[0m \033[1;38;5;39mjoseamonterroso1999@gmail.com\033[0m"
print "\033[1;38;5;252mGeneration    :\033[0m \033[1;38;5;220m$gen\033[0m"
print "\033[1;38;5;252mLock ID       :\033[0m \033[1;38;5;220m$lock_id\033[0m"
print "\033[1;38;5;252mDevice Model  :\033[0m \033[1;38;5;220m$model\033[0m"
print "\033[1;38;5;252mFree Storage  :\033[0m \033[1;38;5;220m${free_mb} MB\033[0m"
print "\033[1;38;5;39m════════════════════════════════════════════════════════════════\033[0m\n"
