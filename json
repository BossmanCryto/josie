#!/data/data/com.termux/files/usr/bin/zsh
typeset -r CORE_ROOT="$HOME/josie_core"
typeset -r LEDGER_FILE="$CORE_ROOT/kernel_state.json"
typeset -r LOG_FILE="$CORE_ROOT/josie_core.log"

[[ -d "$CORE_ROOT" ]] || mkdir -p "$CORE_ROOT"
cd "$CORE_ROOT"

[[ -f ".git/index.lock" ]] && rm -f ".git/index.lock"
[[ -f "$LEDGER_FILE" ]] || print '{"architecture": "Physical + Digital = Human (P+D=H)", "generation": 0}' > "$LEDGER_FILE"

typeset -i gen=0
gen=$(grep -o '"generation": *[0-9]*' "$LEDGER_FILE" 2>/dev/null | grep -o '[0-9]*' | head -n 1)
(( gen++ ))

local ts=$(date '+%Y-%m-%d %H:%M:%S')
local cid=$(print -n "$ts-$gen" | sha256sum | awk '{print $1}')
cid=${cid[1,12]}

local model=$(getprop ro.product.model 2>/dev/null)
model=${model:-SM-A176U}

typeset -i free_mb=0
local df_out=$(df -k . 2>/dev/null | tail -n 1 | awk '{print $4}')
[[ -n "$df_out" && "$df_out" =~ ^[0-9]+$ ]] && free_mb=$(( df_out / 1024 ))

cat << JSON > "$LEDGER_FILE"
{
  "architecture": "Physical + Digital = Human (P+D=H)",
  "generation": $gen,
  "last_cycle": "$cid",
  "last_timestamp": "$ts",
  "telemetry": {
    "device_model": "$model",
    "storage_free_mb": $free_mb,
    "shell": "Zsh $ZSH_VERSION"
  },
  "status": "Platform Core Sovereign Engine Active"
}
JSON

git remote set-url origin https://github.com/BossmanCryto/jsi.git 2>/dev/null
git add -A 2>/dev/null
git commit -m "Josie Core Platform Sovereign Sync [$cid]: $ts" 2>/dev/null
git push -u origin main --force 2>/dev/null

clear
print "\n\e[1;36m================================================================\e[0m"
print "\e[1;32m       JOSIE CORE PLATFORM OVERHAUL INITIALIZED (JSON)\          \e[0m"
print "\e[1;36m================================================================\e[0m"
print "\e[1;33mArchitecture:\e[0m Physical + Digital = Human (P + D = H)"
print "\e[1;33mGeneration  :\e[0m $gen"
print "\e[1;33mCycle ID    :\e[0m $cid"
print "\e[1;33mDevice Model:\e[0m $model"
print "\e[1;33mFree Storage:\e[0m ${free_mb} MB"
print "\e[1;33mWorkspace   :\e[0m $CORE_ROOT"
print "\e[1;36m================================================================\e[0m\n"
