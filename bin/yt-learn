#!/usr/bin/env python3
"""
⚡ JOSIE OS: Autonomous YouTube & Web Intelligence Harvester
Discovers, deduplicates, and extracts knowledge from YouTube videos
and stores insights permanently in SQLite cognitive memory.
"""
import os
import sys
import re
import json
import time
import sqlite3
import urllib.request
import urllib.parse
from datetime import datetime, timezone

DB_PATH = os.path.expanduser("~/hummie/core/josie_memory.db")
USER_AGENT = "Mozilla/5.0 (Linux; Android 14; SM-A176U) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36"

DEFAULT_TOPICS = [
    "Samsung Galaxy carrier unlock Odin firmware",
    "Android 14 Wireless Debugging adb termux",
    "Kali NetHunter termux install without root",
    "eSIM DSDS profile bypass Android",
    "Termux autonomous AI swarm local LLM"
]

def init_db():
    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute('''
        CREATE TABLE IF NOT EXISTS yt_harvest_history (
            video_id TEXT PRIMARY KEY,
            title TEXT,
            channel TEXT,
            url TEXT,
            summary TEXT,
            harvest_time TEXT
        )
    ''')
    conn.commit()
    conn.close()

def is_video_seen(video_id: str) -> bool:
    try:
        conn = sqlite3.connect(DB_PATH)
        cur = conn.cursor()
        cur.execute("SELECT 1 FROM yt_harvest_history WHERE video_id = ?", (video_id,))
        seen = cur.fetchone() is not None
        conn.close()
        return seen
    except Exception:
        return False

def record_video(video_id: str, title: str, channel: str, url: str, summary: str):
    try:
        conn = sqlite3.connect(DB_PATH)
        cur = conn.cursor()
        now = datetime.now(timezone.utc).isoformat()
        cur.execute('''
            INSERT OR REPLACE INTO yt_harvest_history (video_id, title, channel, url, summary, harvest_time)
            VALUES (?, ?, ?, ?, ?, ?)
        ''', (video_id, title, channel, url, summary, now))
        
        # Also log to swarm core facts
        cur.execute('''
            INSERT INTO memory (timestamp, event, outcome)
            VALUES (?, ?, ?)
        ''', (now, f"yt_harvest:{video_id}", f"[{channel}] {title} | {summary}"))
        conn.commit()
        conn.close()
    except Exception as e:
        print(f"⚠️ Memory record error: {e}")

def search_youtube(query: str, max_results: int = 5):
    fc_key = os.environ.get("FIRECRAWL_API_KEY", "fc-efb38e686ec24eb1ae22d0280ca6f38f")
    videos = []

    # 1. Primary Engine: Firecrawl v2 Search
    if fc_key:
        try:
            fc_query = f"site:youtube.com {query}"
            headers = {"Content-Type": "application/json", "User-Agent": "Firecrawl-Agent/2.0", "Authorization": f"Bearer {fc_key}"}
            req = urllib.request.Request(
                "https://api.firecrawl.dev/v2/search",
                data=json.dumps({"query": fc_query, "limit": max_results}).encode("utf-8"),
                headers=headers
            )
            with urllib.request.urlopen(req, timeout=15) as r:
                res = json.loads(r.read().decode("utf-8"))
                web_items = res.get("data", {}).get("web", [])
                for item in web_items:
                    vurl = item.get("url", "")
                    m = re.search(r'(?:v=|youtu\.be/)([a-zA-Z0-9_-]{11})', vurl)
                    vid = m.group(1) if m else None
                    if vid and vid not in [v['id'] for v in videos]:
                        title = item.get("title", "").replace(" - YouTube", "")
                        videos.append({
                            'id': vid,
                            'title': title,
                            'channel': 'YouTube Verified',
                            'desc': item.get("description", ""),
                            'url': f"https://www.youtube.com/watch?v={vid}"
                        })
                        if len(videos) >= max_results:
                            return videos
        except Exception as e:
            print(f"⚠️ Firecrawl search fallback: {e}")

    if videos:
        return videos

    # 2. Fallback Direct Scrape
    encoded = urllib.parse.quote(query)
    url = f"https://www.youtube.com/results?search_query={encoded}"
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            html = resp.read().decode('utf-8', errors='ignore')
            raw_matches = re.findall(r'"videoId":"([a-zA-Z0-9_-]{11})".*?"title":{"runs":\[{"text":"(.*?)"}\]', html)
            for vid, title in raw_matches:
                if vid not in [v['id'] for v in videos]:
                    videos.append({
                        'id': vid,
                        'title': title,
                        'channel': 'YouTube Creator',
                        'desc': '',
                        'url': f"https://www.youtube.com/watch?v={vid}"
                    })
                    if len(videos) >= max_results:
                        return videos
    except Exception as e:
        print(f"⚠️ Direct scrape error for '{query}': {e}")
    return videos

def harvest_topics(topics=None, max_per_topic=3):
    init_db()
    if not topics:
        topics = DEFAULT_TOPICS
        
    print(f"\n⚡ [YT-LEARN] Commencing Video Intelligence Harvest ({len(topics)} topics)...")
    new_count = 0
    
    for t in topics:
        print(f"\n🔍 Querying: \033[1;36m{t}\033[0m")
        results = search_youtube(t, max_results=max_per_topic)
        
        for v in results:
            vid = v['id']
            if is_video_seen(vid):
                continue
                
            new_count += 1
            title = v['title']
            channel = v['channel']
            vurl = v['url']
            summary = v['desc'][:180] if v['desc'] else f"Technical guide on {t}"
            
            record_video(vid, title, channel, vurl, summary)
            
            print(f"  ✨ \033[1;32m[NEW DISCOVERY]\033[0m {title}")
            print(f"     👤 Channel : {channel}")
            print(f"     🔗 URL     : {vurl}")
            print(f"     📝 Summary : {summary}\n")
            
        time.sleep(1)
        
    print(f"✅ Harvest completed. {new_count} new video entries permanently indexed into josie_memory.db.")

def list_harvested(limit=15):
    init_db()
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute("SELECT video_id, title, channel, url, harvest_time FROM yt_harvest_history ORDER BY harvest_time DESC LIMIT ?", (limit,))
    rows = cur.fetchall()
    conn.close()
    
    print(f"\n📚 [INDEXED VIDEO INTELLIGENCE] (Latest {len(rows)} entries):")
    for r in rows:
        print(f"  • [{r[4][:16]}] \033[1;32m{r[1]}\033[0m")
        print(f"    Channel: {r[2]} | {r[3]}")
    print()

def main():
    if len(sys.argv) < 2:
        print("Usage:")
        print("  yt-learn search <topic>   -> Search & learn new videos for specific topic")
        print("  yt-learn harvest          -> Full harvest across core ecosystem topics")
        print("  yt-learn list             -> Display catalog of learned videos")
        print("  yt-learn daemon           -> Continuous background harvester")
        sys.exit(0)
        
    action = sys.argv[1].lower()
    
    if action == "search":
        q = " ".join(sys.argv[2:]) if len(sys.argv) > 2 else DEFAULT_TOPICS[0]
        harvest_topics([q], max_per_topic=5)
    elif action in ["harvest", "run", "start"]:
        harvest_topics()
    elif action == "list":
        list_harvested()
    elif action == "daemon":
        print("⚡ Launching autonomous background video harvester daemon...")
        while True:
            harvest_topics(max_per_topic=2)
            print("💤 Sleeping 4 hours until next scheduled sweep...")
            time.sleep(14400)
    else:
        harvest_topics([" ".join(sys.argv[1:])], max_per_topic=5)

if __name__ == "__main__":
    main()
