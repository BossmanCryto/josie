#!/usr/bin/env python3
"""
⚡ JOSIE AGI CLI (Apex Terminal Intelligence)
Unified command center for Termux, Chromebook SSH, and Web Ecosystem.
"""
import sys
import os
import subprocess
import json
import sqlite3
import urllib.request
import urllib.parse
import re

DB_PATH = "/data/data/com.termux/files/home/hummie/core/josie_memory.db"
PORT = 8080
VSCODE_PORT = 8088

def print_banner():
    print("\033[1;36m╔══════════════════════════════════════════════════════════════════╗\033[0m")
    print("\033[1;36m║                  ⚡ JOSIE AGI UNIFIED CLI (v2.0)                 ║\033[0m")
    print("\033[1;36m╚══════════════════════════════════════════════════════════════════╝\033[0m")

def get_telemetry():
    b_level, temp, cur = "100", "30.0", "0"
    try:
        res = subprocess.run(["dumpsys", "battery"], capture_output=True, text=True, timeout=2).stdout
        b = re.search(r"level:\s*(\d+)", res)
        t = re.search(r"temperature:\s*(\d+)", res)
        c = re.search(r"current_now:\s*(-?\d+)", res)
        if b: b_level = b.group(1)
        if t: temp = f"{int(t.group(1))/10:.1f}"
        if c: cur = c.group(1)
    except Exception: pass
    return b_level, temp, cur

def cmd_check():
    print_banner()
    print("🔍 \033[1;33mRUNNING FULL AGI ECOSYSTEM DIAGNOSTIC SWEEP...\033[0m\n")

    # 1. IP
    ip = "192.168.1.23"
    try:
        res = subprocess.run("ip -4 addr show wlan0 2>/dev/null | grep -oP '(?<=inet\\s)\\d+(\\.\\d+){3}'", shell=True, capture_output=True, text=True).stdout.strip()
        if res: ip = res
    except Exception: pass
    print(f"  • \033[1mNetwork IP\033[0m            : \033[1;32m{ip}\033[0m (wlan0)")

    # 2. Services
    sshd = subprocess.run("pgrep sshd", shell=True, capture_output=True).returncode == 0
    web = subprocess.run("pgrep -f web_app.py", shell=True, capture_output=True).returncode == 0
    vscode = subprocess.run("pgrep -f code-server", shell=True, capture_output=True).returncode == 0

    print(f"  • \033[1mSSH Daemon (8022)\033[0m     : {'\033[1;32m✔ ACTIVE (Chromebook authorized)\033[0m' if sshd else '\033[1;31m○ STOPPED\033[0m'}")
    print(f"  • \033[1mJosie AGI Web (8080)\033[0m  : {'\033[1;32m✔ ACTIVE (http://127.0.0.1:8080)\033[0m' if web else '\033[1;31m○ STOPPED\033[0m'}")
    print(f"  • \033[1mVS Code Web (8088)\033[0m    : {'\033[1;32m✔ ACTIVE (https://127.0.0.1:8088)\033[0m' if vscode else '\033[1;31m○ STOPPED\033[0m'}")

    # 3. Shizuku
    rish_ok = False
    try:
        rish = subprocess.run("echo id | /data/data/com.termux/files/home/bin/rish", shell=True, capture_output=True, text=True, timeout=2)
        rish_ok = "uid=" in rish.stdout
    except Exception:
        pass
    print(f"  • \033[1mShizuku Bridge (rish)\033[0m : {'\033[1;32m✔ ELEVATED (uid=2000 shell)\033[0m' if rish_ok else '\033[1;33m○ STANDBY\033[0m'}")

    # 4. Hardware Telemetry
    b, t, c = get_telemetry()
    print(f"  • \033[1mHardware Guardian\033[0m     : Battery {b}% | Temp {t}°C | Current {c} mA")

    # 5. Permanent Memory
    if os.path.exists(DB_PATH):
        try:
            conn = sqlite3.connect(DB_PATH)
            cnt = conn.cursor().execute("SELECT count(*) FROM memory").fetchone()[0]
            conn.close()
            print(f"  • \033[1mPermanent Memory\033[0m      : \033[1;36m{cnt} entries indexed\033[0m")
        except Exception: pass

    print("\n\033[1;32m✅ All core AGI components operational!\033[0m\n")

def cmd_fix():
    print_banner()
    print("🛠️ \033[1;33mEXECUTING FULL AUTONOMOUS SELF-HEALING & REPAIR...\033[0m\n")

    # 1. SSH Server
    if subprocess.run("pgrep sshd", shell=True, capture_output=True).returncode != 0:
        subprocess.run("sshd", shell=True)
        print("  • \033[1;32m✔ SSH Server started on port 8022\033[0m")
    else:
        print("  • \033[1;32m✔ SSH Server already active (port 8022)\033[0m")

    # 2. Web App
    subprocess.run("/data/data/com.termux/files/home/bin/start-agi >/dev/null 2>&1", shell=True)
    print("  • \033[1;32m✔ Josie AGI Cockpit (:8080) synchronized and running\033[0m")

    # 3. VS Code
    if subprocess.run("pgrep -f code-server", shell=True, capture_output=True).returncode != 0:
        subprocess.run("/data/data/com.termux/files/home/bin/start-code-server >/dev/null 2>&1", shell=True)
        print("  • \033[1;32m✔ VS Code Web (:8088 HTTPS) restarted\033[0m")
    else:
        print("  • \033[1;32m✔ VS Code Web (:8088 HTTPS) healthy\033[0m")

    # 4. Clear locks
    subprocess.run("rm -f $PREFIX/tmp/.*.swp ~/.vscode_stale* /tmp/*.lock 2>/dev/null", shell=True)
    print("  • \033[1;32m✔ Cleared stale lock files & temp buffers\033[0m")

    print("\n\033[1;32m🚀 Self-healing routine complete! All systems green.\033[0m\n")

def cmd_memory(query):
    print_banner()
    if not os.path.exists(DB_PATH):
        print("⚠️ Memory database not found at", DB_PATH)
        return
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    if query:
        print(f"🧠 \033[1;33mQuerying Permanent Memory Vault for '{query}'...\033[0m\n")
        c.execute("SELECT timestamp, event, outcome FROM memory WHERE event LIKE ? OR outcome LIKE ? ORDER BY id DESC LIMIT 5", (f"%{query}%", f"%{query}%"))
    else:
        print("🧠 \033[1;33mRecent Knowledge & Event Memories:\033[0m\n")
        c.execute("SELECT timestamp, event, outcome FROM memory ORDER BY id DESC LIMIT 5")
    rows = c.fetchall()
    conn.close()

    if not rows:
        print("No matching memories found.")
        return
    for r in rows:
        print(f"\033[1;36m• [{r[0]}]\033[0m \033[1m{r[1]}\033[0m")
        print(f"  \033[0;37m↳ {r[2][:250]}\033[0m\n")

MODELS_LIST = [
