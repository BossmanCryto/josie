    ("anthropic/claude-3.5-haiku", "Claude 3.5 Haiku (Anthropic)"),
    ("deepseek/deepseek-chat:free", "DeepSeek V3 (Free Tier)"),
    ("deepseek/deepseek-r1:free", "DeepSeek R1 Reasoning (Free Tier)"),
    ("meta-llama/llama-3.3-70b-instruct:free", "Llama 3.3 70B Instruct (Free Tier)"),
    ("google/gemini-2.0-flash-exp:free", "Gemini 2.0 Flash (Free Tier)"),
    ("qwen/qwen-2.5-72b-instruct:free", "Qwen 2.5 72B Instruct (Free Tier)"),
    ("mistralai/mistral-small-24b-instruct-2501:free", "Mistral Small 24B (Free Tier)"),
    ("openai/gpt-4o", "GPT-4o (OpenAI)"),
    ("openai/gpt-4o-mini", "GPT-4o Mini (OpenAI)"),
    ("openai/o1", "OpenAI o1 Reasoning")
]

def cmd_models():
    print_banner()
    print("🧠 \033[1;33mAVAILABLE COGNITIVE MODELS (Claude, OpenRouter, Free Cascade):\033[0m\n")
    for mid, mname in MODELS_LIST:
        print(f"  • \033[1;32m{mid}\033[0m\n    ↳ {mname}")
    print("\n💡 \033[1mUsage:\033[0m agi ask -m <model_id> \"<prompt>\"\n")

def cmd_ask(prompt, model="anthropic/claude-3.7-sonnet"):
    print(f"⚡ \033[1;33mJosie AGI Core\033[0m [\033[1;36m{model.split('/')[-1]}\033[0m]: Processing...\n")
    try:
        data = json.dumps({"prompt": prompt, "model": model}).encode()
        req = urllib.request.Request("http://127.0.0.1:8080/chat", data=data, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=25) as r:
            res = json.loads(r.read().decode())
            print(res.get("reply", "(No response)"))
    except Exception as e:
        # Direct CLI fallback via Pollinations
        try:
            clean = urllib.parse.quote(prompt[:400])
            req = urllib.request.Request(f"https://text.pollinations.ai/{clean}", headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=12) as r:
                print(r.read().decode().strip())
        except Exception as e2:
            print(f"⚠️ Error: {e} / {e2}")

def get_openrouter_key():
    k = os.environ.get("OPENROUTER_API_KEY", "")
    if k: return k
    p = os.path.expanduser("~/.openrouter_key")
    if os.path.exists(p):
        try: return open(p).read().strip()
        except Exception: pass
    return ""

def plan_bash_command(task):
    # Rule-based fast planner for common tasks
    t_low = task.lower().strip()
    if t_low in ("check", "status", "health", "audit", "diagnostics", "verify health", "verify system health"):
        return "agi check"
    if t_low in ("fix", "fix all", "repair", "auto fix", "heal"):
        return "agi fix"
    if t_low.startswith("scrape ") or t_low.startswith("scrape:"):
        return f"agi scrape {task.split(maxsplit=1)[1]}"
    if t_low.startswith("search ") or t_low.startswith("search:"):
        return f"agi search {task.split(maxsplit=1)[1]}"

    prompt = (
        f"You are Josie AGI CLI automation engine. Output ONLY a single executable Linux/Termux bash command to accomplish this task: '{task}'. "
        f"Do not include markdown code fences, do not include quotes around the whole line, do not include explanations. Only the raw command."
    )

    # 1. OpenRouter (Claude 3.7 / DeepSeek)
    or_key = get_openrouter_key()
    if or_key:
        try:
            url = "https://openrouter.ai/api/v1/chat/completions"
            headers = {
                "Content-Type": "application/json",
                "Authorization": f"Bearer {or_key}",
                "HTTP-Referer": "http://192.168.1.23:8080",
                "X-Title": "Josie AGI Swarm"
            }
            data = json.dumps({
                "model": "anthropic/claude-3.7-sonnet",
                "messages": [{"role": "user", "content": prompt}],
                "max_tokens": 120
            }).encode("utf-8")
            req = urllib.request.Request(url, data=data, headers=headers)
            with urllib.request.urlopen(req, timeout=8) as resp:
                res = json.loads(resp.read().decode("utf-8"))
                cmd = res["choices"][0]["message"]["content"].strip()
                if cmd: return cmd
        except Exception:
            pass

    # 2. Local Cockpit Chat Engine
    try:
        data = json.dumps({"prompt": prompt, "model": "anthropic/claude-3.7-sonnet"}).encode()
        req = urllib.request.Request("http://127.0.0.1:8080/chat", data=data, headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=10) as r:
            res = json.loads(r.read().decode())
            cmd = res.get("reply", "").strip()
            if cmd and not cmd.startswith("{") and not cmd.startswith("⚡"): return cmd
    except Exception:
        pass

    # 3. Pollinations fallback
    try:
        clean = urllib.parse.quote(prompt[:350])
        req = urllib.request.Request(f"https://text.pollinations.ai/{clean}", headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=8) as r:
            cmd = r.read().decode().strip()
            if cmd: return cmd
    except Exception:
        pass

    return ""

def cmd_do(task):
    print("⚡ \033[1;33mJosie AGI Autonomous Action Engine:\033[0m")
    print(f"🎯 \033[1mTask:\033[0m {task}\n")

    cmd = plan_bash_command(task)
    cmd = re.sub(r"^```(?:bash|sh)?\s*", "", cmd)
    cmd = re.sub(r"\s*```$", "", cmd).strip()
    cmd = cmd.strip('`').strip('"').strip("'")

    if cmd and len(cmd) < 400 and not cmd.startswith("Error") and not cmd.startswith("{"):
        print(f"🚀 \033[1;36mExecuting:\033[0m \033[1m{cmd}\033[0m\n")
        env = os.environ.copy()
        env["PATH"] = os.path.expanduser("~/.local/bin:") + os.path.expanduser("~/bin:") + env.get("PATH", "")
        res = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=60, env=env)
        out = (res.stdout + res.stderr).strip() or "(Executed with exit code 0)"
        print(out)
        if os.path.exists(DB_PATH):
            try:
                conn = sqlite3.connect(DB_PATH)
                conn.cursor().execute("INSERT INTO memory (timestamp, event, outcome) VALUES (datetime('now'), ?, ?)", (f"AGI DO: {task} -> {cmd}", out[:400]))
                conn.commit()
                conn.close()
            except Exception: pass
        print(f"\n\033[1;32m✔ Task completed (Exit {res.returncode})\033[0m\n")
    else:
        print("⚠️ Could not deduce a bash command; consulting Josie cognitive suite...\n")
        cmd_ask(f"Task to accomplish: {task}")

def cmd_help():
    print_banner()
    print("Usage: agi <command> [args]\n")
    print("Commands:")
    print("  \033[1;32magi do <task>\033[0m        Command AGI to autonomously plan & execute task")
    print("  \033[1;32magi check\033[0m           Full diagnostic audit (ports, Shizuku, hardware)")
    print("  \033[1;32magi fix\033[0m             Autonomous auto-repair (SSH, VS Code, locks)")
    print("  \033[1;32magi web\033[0m             Start / verify Josie AGI Web Cockpit (:8080)")
    print("  \033[1;32magi memory [q]\033[0m      Search permanent SQLite knowledge vault")
    print("  \033[1;32magi ask <prompt>\033[0m    Prompt Claude 3.7 / OpenRouter with memory")
    print("  \033[1;32magi scrape <url>\033[0m    Firecrawl v2 clean markdown scrape")
    print("  \033[1;32magi search <query>\033[0m  Firecrawl v2 live web intelligence search")
    print("  \033[1;32magi status\033[0m          Quick ecosystem overview\n")

def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        cmd_help()
        return

    subcmd = args[0].lower()
    if subcmd in ("do", "run", "goal", "task", "exec"):
        if len(args) < 2:
            print("Usage: agi do <task to accomplish>")
            return
        cmd_do(" ".join(args[1:]))
    elif subcmd in ("check", "audit", "diagnostics"):
        cmd_check()
    elif subcmd in ("fix", "repair", "heal", "tune"):
        cmd_fix()
    elif subcmd in ("web", "gui", "cockpit"):
        subprocess.run("/data/data/com.termux/files/home/bin/start-agi", shell=True)
    elif subcmd in ("status", "eco"):
        subprocess.run("/data/data/com.termux/files/home/bin/status-ecosystem", shell=True)
    elif subcmd in ("memory", "recall", "vault"):
        q = " ".join(args[1:]) if len(args) > 1 else ""
        cmd_memory(q)
    elif subcmd in ("models", "model", "list-models"):
        cmd_models()
    elif subcmd in ("ask", "q", "prompt"):
        if len(args) < 2:
            print("Usage: agi ask [-m <model>] <prompt>")
            return
        m_val = "anthropic/claude-3.7-sonnet"
        remaining = args[1:]
        if len(remaining) >= 2 and remaining[0] in ("-m", "--model"):
            m_val = remaining[1]
            remaining = remaining[2:]
        if not remaining:
            print("Usage: agi ask [-m <model>] <prompt>")
            return
        cmd_ask(" ".join(remaining), model=m_val)
    elif subcmd in ("scrape", "fc-scrape"):
        if len(args) < 2:
            print("Usage: agi scrape <url>")
            return
        subprocess.run(["fc-scrape"] + args[1:])
    elif subcmd in ("search", "fc-search"):
        if len(args) < 2:
            print("Usage: agi search <query>")
            return
        subprocess.run(["fc-search"] + args[1:])
    else:
        # Default to asking AGI or checking -m flag
        m_val = "anthropic/claude-3.7-sonnet"
        remaining = args
        if len(remaining) >= 2 and remaining[0] in ("-m", "--model"):
            m_val = remaining[1]
            remaining = remaining[2:]
        cmd_ask(" ".join(remaining), model=m_val)

if __name__ == "__main__":
    main()
